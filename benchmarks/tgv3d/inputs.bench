# Benchmark: 3-D Taylor-Green vortex (triply periodic).
# One wavelength per box, k=2*pi/N, periodic in x,y,z. 3-D extension of tgv2d.

# ── Grid ──────────────────────────────────────────────────────────────────
# Default local: 64^3; Aurora weak: 128^3 per GPU (256^3 per node)
grid.ncells      = 768 768 768
grid.max_grid_size = 64
grid.n_ghost     = 1

# ── Simulation ───────────────────────────────────────────────────────────
sim.max_step     = 550  # bench.warmup + bench steps (3D default: 50 warmup + 500 timed)
bench.warmup     = 50
sim.stop_time    = -1.0

# ── LBM ──────────────────────────────────────────────────────────────────
lbm.lattice_type = D3Q19
lbm.tau          = 0.8      # pinned directly: nu_lat = (tau-0.5)*cs2 = 0.1

# ── Physical units ─────────────────────────────────────────────────────────
# Want Re about 1600. To keep Ulat < 0.2 need N=768 or more
units.ref_length    = 1.0
units.ref_velocity  = 0.01
units.Re            = 1600.0

# ── Boundary conditions ────────────────────────────────────────────────────
bc.lo_type = Periodic  Periodic  Periodic
bc.hi_type = Periodic  Periodic  Periodic

# ── Geometry ───────────────────────────────────────────────────────────────
geometry.prob_lo    = 0.0  0.0  0.0
geometry.prob_hi    = 1.0  1.0  1.0

# ── Output ─────────────────────────────────────────────────────────────────
# Benchmark: no plotfile I/O by default; checkpoint is opt-in via bench.save_checkpoint.
amr.plot_int        = -1
amr.chk_int         = -1
amr.plot_file       = plt
amr.check_file      = chk
bench.save_checkpoint = 0   # set to 1 to write chk<max_step> after timed region (for analysis / load-balancing)
