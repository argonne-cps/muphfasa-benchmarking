# Validation: 3-D Taylor-Green vortex at Re=1600 vs. Dairay et al. 2017 DNS (TGV_Re1600.dat).
#
# Triply-periodic NxNxN domain, one TGV wavelength per side (see ../Tgv3dAnalytic.H).
# Initial condition (Taylor & Green 1937; Brachet et al. 1983):
#   u =  U0 sin(kx) cos(ky) cos(kz)
#   v = -U0 cos(kx) sin(ky) cos(kz)
#   w =  0
#
# Units: the DNS reference uses domain (2pi)^3, k=1, U0=1, nu=1/1600, so the
# simulation is run directly in those units and results compare 1:1 to
# TGV_Re1600.dat (t=0: Ek=0.125, <(du/dx)^2>=0.125).
#   domain length  = units.ref_length = 2pi   (muphfasa sets dx = ref_length/N,
#                                              and InitData uses k = 2pi/(N dx) = 1)
#   units.Re       = U0 * ref_length / nu = 2pi * 1600
# NOTE: units.Re is based on ref_length, so it is 2pi*Re_bench, NOT 1600.
#
# Default N=512 matches the reference 512^3 DNS (see TGV_Re1600.dat header).
# For local smoke tests see inputs.small (N=32, Re_bench=100).

# ── Grid ──────────────────────────────────────────────────────────────────
grid.ncells       = 512 512 512   # cubic: one TGV wavelength per side
grid.max_grid_size = 64           # chop into 64^3 boxes for MPI distribution
grid.n_ghost      = 1

# ── Simulation ────────────────────────────────────────────────────────────
# Benchmark time t=20 (units of L/U0 with L=1). Lattice: dx=2pi/N=0.012272,
# dt=u_lat*dx/U0=1.2272e-3  ->  t=20 is ~16300 steps. max_step is just a cap;
# sim.stop_time ends the run.
sim.max_step     = 20000
sim.stop_time    = 20.0

# ── LBM ──────────────────────────────────────────────────────────────────
lbm.lattice_type = D3Q19
# Pin u_lat (lattice ref velocity, Ma = u_lat/cs). With nu=1/1600, dx=2pi/512:
#   tau = 0.5 + 3*nu*u_lat/(U0*dx) = 0.5 + 0.1528*u_lat
# u_lat=0.1 -> tau=0.5153, Ma=0.17. Lower u_lat -> tau closer to 0.5 (less
# stable for BGK) but smaller compressibility error and more steps.
lbm.u_lat        = 0.1

# ── Physical units ───────────────────────────────────────────────────────
units.ref_length    = 6.283185307179586
units.ref_velocity  = 1.0
units.ref_density   = 1.0
units.Re            = 10053.096491487338    # = 2pi * 1600  ->  nu = 1/1600

# ── Boundary conditions ──────────────────────────────────────────────────
bc.lo_type = Periodic  Periodic  Periodic
bc.hi_type = Periodic  Periodic  Periodic

# ── Geometry ─────────────────────────────────────────────────────────────
geometry.prob_lo    = 0.0  0.0  0.0
geometry.prob_hi    = 6.283185307179586  6.283185307179586  6.283185307179586

# ── Output ───────────────────────────────────────────────────────────────
# Plotfiles contain density + velocity in physical units (yt analysis).
# amr.plot_int=163 -> dt_out=0.2 -> ~100 plotfiles (~300 GB at N=512); raise it
# if disk-limited. bench.sample_int sets the in-situ CSV (tgv_diagnostics.csv)
# cadence (tiny; ~0.02 time units here); defaults to plot_int if unset.
amr.plot_int        = 163
amr.chk_int         = 100000
amr.plot_file       = plt
amr.check_file      = chk

bench.sample_int    = 16
