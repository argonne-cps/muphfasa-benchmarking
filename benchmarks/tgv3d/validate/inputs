# Correctness test: 3-D Taylor-Green vortex decay.
# Triply-periodic NxN^3 domain, one wavelength per side (see ../Tgv3dAnalytic.H).
# ../InitData.cpp (one directory up, shared with bench) sets t=0 IC; test_tgv3d.cpp
# compares evolution against same analytic at later times.

# ── Grid ──────────────────────────────────────────────────────────────────
grid.ncells      = 32 32 32   # cubic: one wavelength per side
grid.max_grid_size = 32
grid.n_ghost     = 1

# ── Simulation ───────────────────────────────────────────────────────────
# At N=32, tau=0.8 (nu_lat=0.1) and k=2*pi/32, velocity decays as exp(-2*nu*k^2*t);
# max_step=200 reaches ~90% decay, giving amr.plot_int=50 sequence.
sim.max_step     = 200
sim.stop_time    = -1.0

# ── LBM ──────────────────────────────────────────────────────────────────
lbm.lattice_type = D3Q19
lbm.tau          = 0.8

# ── Physical units ─────────────────────────────────────────────────────────
# units.Re nonzero but irrelevant since tau pinned; ref_velocity is TGV amplitude
# converted to lattice via UnitConverter::toLatticeVelocity().
units.ref_length    = 32.0
units.ref_velocity  = 0.01
units.Re            = 1.0

# ── Boundary conditions ────────────────────────────────────────────────────
bc.lo_type = Periodic  Periodic  Periodic
bc.hi_type = Periodic  Periodic  Periodic

# ── Geometry ───────────────────────────────────────────────────────────────
geometry.prob_lo    = 0.0  0.0  0.0
geometry.prob_hi    = 1.0  1.0  1.0

# ── Output ─────────────────────────────────────────────────────────────────
amr.plot_int        = 50
amr.chk_int         = 201
amr.plot_file       = plt
amr.check_file      = chk
