# Small smoke test for TGV (N=32) — verifies code path without HPC resources.
# Re is lowered to 100 for stability at coarse resolution. Same L=1 convention
# as inputs (k=2pi) so diagnostics map up to the 2pi domain-scale factor.
grid.ncells       = 32 32 32
grid.max_grid_size = 32
grid.n_ghost      = 1

sim.max_step     = 800
sim.stop_time    = 0.5

lbm.lattice_type = D3Q19
lbm.u_lat        = 0.08

units.ref_length    = 1.0
units.ref_velocity  = 1.0
units.ref_density   = 1.0
units.Re            = 100.0

bc.lo_type = Periodic  Periodic  Periodic
bc.hi_type = Periodic  Periodic  Periodic

geometry.prob_lo    = 0.0  0.0  0.0
geometry.prob_hi    = 1.0  1.0  1.0

amr.plot_int        = 200
amr.chk_int         = 100000
amr.plot_file       = plt
amr.check_file      = chk
