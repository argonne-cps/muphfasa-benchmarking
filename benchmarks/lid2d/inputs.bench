# Benchmark: 2-D Lid-driven cavity (closed square, walls on all four sides).
# Lid at y=hi moves at U0 in +x; the other three walls are no-slip. Re=100 (see
# units.Re / tau below), matching the Ghia et al. (1982) reference used by the
# upstream external/muphfasa/tests/regression/lid_driven_cavity test; override
# units.Re + lbm.tau for other Re.

# ── Grid ──────────────────────────────────────────────────────────────────
# Default for local: 64^2; for Aurora weak scaling use ~1024^2 per GPU (override
# via grid.ncells="1024 1024"). 
grid.ncells      = 64 64
grid.max_grid_size = 64
grid.n_ghost     = 1

# ── Simulation ───────────────────────────────────────────────────────────
sim.max_step     = 2100  # bench.warmup + bench steps (2D default: 100 warmup + 2000 timed)
bench.warmup     = 100
sim.stop_time    = -1.0

# ── LBM ──────────────────────────────────────────────────────────────────
lbm.lattice_type = D2Q9
lbm.tau = 0.8 # Re=1000, U_lat=0.1, N=1024  

# ── Physical units ─────────────────────────────────────────────────────────
# With lbm.tau pinned, lbm.u_lat becomes is reasonably low for N>1024
units.ref_velocity  = 1.0
units.ref_density   = 1.0
units.Re            = 1000.0

# ── Boundary conditions ────────────────────────────────────────────────────
# All four walls closed: x walls and bottom NoSlip, top (y=hi) MovingWall lid.
bc.lo_type = NoSlip  NoSlip
bc.hi_type = NoSlip  MovingWall
bc.hiy_Uwall = 1.0  0.0   # (vx, vy), physical units

# ── Geometry ───────────────────────────────────────────────────────────────
geometry.prob_lo    = 0.0  0.0
geometry.prob_hi    = 1.0  1.0

# ── Output ─────────────────────────────────────────────────────────────────
# Benchmark: no plotfile I/O by default; checkpoint is opt-in via bench.save_checkpoint.
amr.plot_int        = -1
amr.chk_int         = -1
amr.plot_file       = plt
amr.check_file      = chk
bench.save_checkpoint = 0   # set to 1 to write chk<max_step> after timed region (for analysis / load-balancing)
