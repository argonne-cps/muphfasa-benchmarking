# Benchmark: 2-D Lid-driven cavity (closed square, walls on all four sides).
# Lid at y=hi moves at U0 in +x; the other three walls are no-slip. Re=100 (see
# units.Re / tau below), matching the Ghia et al. (1982) reference used by the
# upstream external/muphfasa/tests/regression/lid_driven_cavity test; override
# units.Re + lbm.tau for other Re.

# ── Grid ──────────────────────────────────────────────────────────────────
# Default for local: 64^2; for Aurora weak scaling use ~1024^2 per GPU (override
# via grid.ncells="1024 1024"). Keep max_grid_size = N to avoid tiling overhead
# for bench.
grid.ncells      = 64 64
grid.max_grid_size = 64
grid.n_ghost     = 1

# ── Simulation ───────────────────────────────────────────────────────────
sim.max_step     = 2100  # bench.warmup + bench steps (2D default: 100 warmup + 2000 timed)
bench.warmup     = 100
sim.stop_time    = -1.0

# ── LBM ──────────────────────────────────────────────────────────────────
lbm.lattice_type = D2Q9
lbm.tau          = 0.692  # Re=100, U_lat=0.1, N=64 -> tau~0.692 (override for Re sweep)

# ── Physical units ─────────────────────────────────────────────────────────
# With lbm.tau pinned, UnitConverter derives u_lat = nu_lat*Re/N (nu_lat =
# (tau-0.5)*cs2 = 0.064 here), so u_lat depends on the grid size actually run:
# 0.1 at N=64, 0.0063 at N=1024. Keep N >= ~43, below which u_lat passes the
# 0.15 soft warning, and N >= 22, below which it hits the u_lat<0.3 hard assert
# (e.g. a run_scaling.py sweep that goes below the default 64^2).
# ref_velocity is the physical lid speed; bc.hiy_Uwall below is converted to
# lattice units via UnitConverter::toLatticeVelocity(), so keep the two equal.
units.ref_length    = 1.0
units.ref_velocity  = 0.05
units.ref_density   = 1.0
units.Re            = 100.0

# ── Boundary conditions ────────────────────────────────────────────────────
# All four walls closed: x walls and bottom NoSlip, top (y=hi) MovingWall lid.
bc.lo_type = NoSlip  NoSlip
bc.hi_type = NoSlip  MovingWall
bc.hiy_Uwall = 0.05  0.0   # (vx, vy), physical units

# ── Geometry ───────────────────────────────────────────────────────────────
geometry.prob_lo    = 0.0  0.0
geometry.prob_hi    = 1.0  1.0

# ── Output ─────────────────────────────────────────────────────────────────
amr.plot_int        = -1
amr.chk_int         = -1
